# Copy to jump.env (gitignored). Disposable droplets only.
TESSERA_JUMP_BASTION_HOST=192.0.2.20
TESSERA_JUMP_TARGET_HOST=192.0.2.21
# Same-VPC private addresses (eth1); target's app sshd binds/filters to these.
TESSERA_JUMP_BASTION_PRIVATE=10.0.0.2
TESSERA_JUMP_TARGET_PRIVATE=10.0.0.3
TESSERA_JUMP_CONTROL_USER=root
TESSERA_JUMP_CONTROL_PORT=22
TESSERA_JUMP_CONTROL_KEY="${JUMP_DIR}/../secrets/tessera-test-fixture-automation-ed25519"
# App-facing endpoints (what Tessera connects to).
TESSERA_JUMP_APP_PORT=2222
# Loopback-only sshd on the target for the multi-hop (A -> B -> C) case.
TESSERA_JUMP_INNER_PORT=2223
TESSERA_JUMP_KEY_USER=tessera
TESSERA_JUMP_PW_USER=tessera-pw
