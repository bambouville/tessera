# Copy to fixture.env. The real file is ignored.
TESSERA_FIXTURE_STABLE_HOST=192.0.2.10
TESSERA_FIXTURE_CHAOS_HOST=192.0.2.11
TESSERA_FIXTURE_CONTROL_USER=root
TESSERA_FIXTURE_CONTROL_PORT=22
# Keep the key under the gitignored scripts/integration/secrets/ directory;
# INTEGRATION_DIR is set by lib.sh before this file is sourced.
TESSERA_FIXTURE_CONTROL_KEY="${INTEGRATION_DIR}/secrets/disposable-control-key"
TESSERA_FIXTURE_APP_PORT=2222
TESSERA_FIXTURE_USER=tessera
TESSERA_FIXTURE_NOTMUX_USER=tessera-notmux
