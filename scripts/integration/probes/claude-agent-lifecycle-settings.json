{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude SessionStart"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude SubagentStop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude PostToolUse"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude PermissionRequest"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude Stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude StopFailure"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$TESSERA_AGENT_PROBE_HOOK\" claude SessionEnd"
          }
        ]
      }
    ]
  }
}
