          }
        }
      }
    },
    "The actual Keychain boundary could not be determined.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die tatsächliche Schlüsselbund-Grenze konnte nicht ermittelt werden."
