    "Drag or share a remote file out to Files, Mail, or Photos. Share a file into Tessera from any app and it lands on the host — the native iOS share sheet, both directions.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh oder teile eine entfernte Datei nach Dateien, Mail oder Fotos. Teile aus jeder App eine Datei nach Tessera, und sie landet auf dem Host — das native iOS-Teilen-Menü, in beide Richtungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra o comparte un archivo remoto a Archivos, Mail o Fotos. Comparte un archivo hacia Tessera desde cualquier app y aterrizará en el host: la hoja de compartir nativa de iOS, en ambos sentidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser ou partagez un fichier distant vers Fichiers, Mail ou Photos. Partagez un fichier vers Tessera depuis n'importe quelle app et il arrive sur l'hôte — la feuille de partage native d'iOS, dans les deux sens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートファイルをファイル、メール、写真へドラッグまたは共有できます。任意のアプリから Tessera へファイルを共有すれば、そのままホストに届きます。iOS 標準の共有シートが双方向で使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把远程文件拖动或共享到“文件”、“邮件”或“照片”。也可以从任意 App 把文件共享到 Tessera，它会直接落到主机上 —— 原生 iOS 共享表单，双向可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把遠端檔案拖曳或分享到「檔案」、「郵件」或「照片」。也可以從任何 App 把檔案分享到 Tessera，它會直接落到主機上 —— 原生 iOS 分享工作表，雙向可用。"
          }
        }
      }
    },
    "EXCLUDED": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AUSGESCHLOSSEN"
          }
        },
        "es": {
          "stringUnit": {
