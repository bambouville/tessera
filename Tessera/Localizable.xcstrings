    "invalid or incomplete rules degrade to “status unavailable”; Agent Center never guesses controls.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige oder unvollständige Regeln fallen auf „Status nicht verfügbar“ zurück; das Agent-Center rät nie, welche Steuerung gemeint ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "las reglas inválidas o incompletas se degradan a «estado no disponible»; el centro de agentes nunca adivina los controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les règles invalides ou incomplètes se dégradent en « état indisponible » ; le centre d'agents ne devine jamais les commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不正または不完全なルールは「状態を取得できません」に切り替わります。エージェントセンターが操作を推測することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效或不完整的规则会降级为「状态不可用」；智能体中心绝不会猜测控件。"
          }
        },
