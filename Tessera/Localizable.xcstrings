        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在本设备的钥匙串中 —— 绝不同步，也绝不发送到另一台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
