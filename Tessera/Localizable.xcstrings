    "still %@ — the connection is up but this stage has not completed.": {
      "comment": "Stalled launch after connecting; the argument is the phase caption, e.g. 'starting tmux'",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "immer noch %@ — die Verbindung steht, aber dieser Schritt ist nicht abgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sigue en %@: la conexión está activa pero esta etapa no ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "toujours %@ — la connexion est établie mais cette étape n'est pas terminée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ %@ — 接続は確立していますが、この段階が完了していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在 %@ — 连接已建立，但这一步尚未完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在 %@ — 連線已建立，但這一步尚未完成。"
          }
        }
      }
    },
