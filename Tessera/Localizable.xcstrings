          "stringUnit": {
            "state": "translated",
            "value": "Tessera 無法建立所請求的工作階段。"
          }
        }
      }
    },
    "Tessera couldn't obtain background time. Keep this sheet open or cancel the upload.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera konnte keine Hintergrundzeit erhalten. Lass dieses Fenster geöffnet oder brich den Upload ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera no pudo obtener tiempo de ejecución en segundo plano. Mantén abierta esta hoja o cancela la subida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera n'a pas pu obtenir de temps d'exécution en arrière-plan. Gardez cette feuille ouverte ou annulez le téléversement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera はバックグラウンド実行時間を確保できませんでした。このシートを開いたままにするか、アップロードをキャンセルしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 无法获得后台运行时间。请保持此面板打开，或取消上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 無法取得背景執行時間。請保持此面板開啟，或取消上傳。"
          }
        }
      }
    },
