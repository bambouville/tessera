          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排除"
          }
        }
      }
    },
    "Ed25519 keys are stored in the iOS Keychain and can be exported as a passphrase-encrypted standard OpenSSH recovery file.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519-Keys werden im iOS-Schlüsselbund gesichert und lassen sich als passphrasenverschlüsselte OpenSSH-Standard-Wiederherstellungsdatei exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves Ed25519 se guardan en el llavero de iOS y se pueden exportar como un archivo de recuperación OpenSSH estándar cifrado con una frase de contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés Ed25519 sont stockées dans le trousseau iOS et peuvent être exportées sous forme de fichier de récupération OpenSSH standard chiffré par phrase secrète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519 キーは iOS のキーチェーンに保存され、パスフレーズで暗号化した標準の OpenSSH 復旧ファイルとして書き出せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519 密钥保存在 iOS 钥匙串中，可导出为使用密码短语加密的标准 OpenSSH 恢复文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519 金鑰儲存在 iOS 鑰匙圈中，可輸出為使用密碼短語加密的標準 OpenSSH 回復檔案。"
          }
        }
      }
    },
