    "SSH key %@… has no trusted metadata. Restore or replace the key before connecting.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den SSH-Key %@… gibt es keine vertrauenswürdigen Metadaten. Stelle den Key wieder her oder ersetze ihn, bevor du dich verbindest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave SSH %@… no tiene metadatos de confianza. Restaura o sustituye la clave antes de conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé SSH %@… n'a pas de métadonnées de confiance. Restaurez ou remplacez la clé avant de vous connecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH キー %@… に信頼できるメタデータがありません。接続する前に、キーを復元するか差し替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 密钥 %@… 没有受信任的元数据。请在连接前恢复或更换该密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 金鑰 %@… 沒有受信任的中繼資料。請在連線前回復或更換該金鑰。"
          }
        }
      }
    },
