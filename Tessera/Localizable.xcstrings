    },
    "Touch the center puck, then swipe toward an option and release to send it. The layout follows live prompts; double-tap the center for dictation.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühre den mittleren Puck, wische dann zu einer Option und lass los, um sie zu senden. Das Layout folgt den aktuellen Rückfragen; ein Doppeltipp in der Mitte startet das Diktat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el disco central, desliza hacia una opción y suelta para enviarla. El diseño sigue las preguntas en vivo; toca dos veces el centro para dictar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le palet central, glissez vers une option et relâchez pour l'envoyer. La disposition suit les invites en direct ; double-touchez le centre pour dicter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央のパックに触れ、選択肢の方向へスワイプして離すと送信されます。レイアウトはライブのプロンプトに追従し、中央をダブルタップすると音声入力が始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸中心圆钮，向某个选项滑动并松开即可发送。布局会跟随实时提示；双击中心可开始听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸摸中心圓鈕，往某個選項滑動並放開即可送出。版面會跟隨即時提示；點兩下中心可開始聽寫。"
          }
        }
      }
    },
    "Tracked access for an earlier host route must be resolved before granting this key again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erfasste Zugang einer früheren Host-Route muss geklärt sein, bevor dieser Key erneut freigegeben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
