    },
    "The metadata for this key exists, but its private material is missing from Keychain. Tessera will not restore sessions or authenticate with it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Metadaten dieses Keys sind vorhanden, sein privates Material fehlt jedoch im Schlüsselbund. Tessera stellt damit keine Sitzungen wieder her und authentifiziert sich nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos de esta clave existen, pero su material privado no está en el llavero. Tessera no restaurará sesiones ni se autenticará con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de cette clé existent, mais son matériel privé est absent du trousseau. Tessera ne restaurera pas de session et ne s'authentifiera pas avec elle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーのメタデータはありますが、秘密情報がキーチェーンに存在しません。Tessera はこのキーでセッションの復元も認証も行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥的元数据存在，但其私密材料不在钥匙串中。Tessera 不会用它恢复会话或进行认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金鑰的中繼資料存在，但其私密材料不在鑰匙圈中。Tessera 不會用它回復工作階段或進行驗證。"
          }
        }
      }
    },
    "The metadata save failed (%@) and protection rollback failed (%@). %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sichern der Metadaten ist fehlgeschlagen (%@), und das Zurücknehmen des Schutzes ebenfalls (%@). %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló el guardado de los metadatos (%@) y también la reversión de la protección (%@). %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement des métadonnées a échoué (%@) et l'annulation de la protection aussi (%@). %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータの保存に失敗し（%@）、保護設定の巻き戻しにも失敗しました（%@）。%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "元数据保存失败（%@），保护设置回滚也失败了（%@）。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼資料儲存失敗（%@），保護設定回滾也失敗了（%@）。%@"
          }
        }
      }
    },
    "The name is shared with every client attached to this tmux session.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
