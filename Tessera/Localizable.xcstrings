    "tessera could not confirm your existing purchase status yet. retry or restore purchases before saving another host.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera konnte deinen bestehenden Kaufstatus noch nicht bestätigen. Versuche es erneut oder stelle Käufe wieder her, bevor du einen weiteren Host sicherst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera todavía no ha podido confirmar el estado de tus compras. reinténtalo o restaura las compras antes de guardar otro host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera n'a pas encore pu confirmer l'état de vos achats. réessayez ou restaurez les achats avant d'enregistrer un autre hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera はまだ既存の購入状況を確認できていません。別のホストを保存する前に、再試行するか購入を復元してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 尚未确认你已有的购买状态。请在保存另一台主机前重试或恢复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 尚未確認你既有的購買狀態。請在儲存另一台主機前重試或回復購買。"
          }
        }
      }
    },
    "tessera could not read saved hosts. nothing was changed; try again.": {
      "comment": "Saved-host count could not be read, so admission was blocked",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera konnte die gesicherten Hosts nicht lesen. es wurde nichts geändert; versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera no pudo leer los hosts guardados. no se cambió nada; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera n'a pas pu lire les hôtes enregistrés. rien n'a été modifié ; réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera は保存されたホストを読み取れませんでした。何も変更されていません。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera 无法读取已保存的主机。未做任何更改；请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera 無法讀取已儲存的主機。未做任何變更；請重試。"
          }
        }
      }
    },
    "tessera is free software, distributed under the GNU General Public License v3. you may use, study, share, and modify it under the terms of that license.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera ist freie Software und wird unter der GNU General Public License v3 verteilt. Du darfst sie im Rahmen dieser Lizenz verwenden, untersuchen, weitergeben und verändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera es software libre, distribuido bajo la GNU General Public License v3. puedes usarlo, estudiarlo, compartirlo y modificarlo según los términos de esa licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera est un logiciel libre, distribué sous la GNU General Public License v3. vous pouvez l'utiliser, l'étudier, le partager et le modifier selon les termes de cette licence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera はフリーソフトウェアであり、GNU General Public License v3 のもとで配布されています。同ライセンスの条件に従って、使用・研究・共有・改変ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera 是自由软件，依据 GNU General Public License v3 发布。你可以在该许可证的条款下使用、研究、分享和修改它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera 是自由軟體，依據 GNU General Public License v3 發布。你可以在該授權條款下使用、研究、分享和修改它。"
          }
        }
      }
    },
    "tessera will not offer a purchase until existing access is confirmed. your saved hosts remain available.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera bietet keinen Kauf an, bevor der bestehende Zugang bestätigt ist. Deine gesicherten Hosts bleiben verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera no ofrecerá ninguna compra hasta confirmar el acceso que ya tienes. tus hosts guardados siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tessera ne proposera aucun achat tant que l'accès existant n'est pas confirmé. vos hôtes enregistrés restent disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の利用権が確認できるまで、tessera が購入を提案することはありません。保存済みのホストは引き続き利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在确认你已有的权限之前，tessera 不会提示购买。你已保存的主机仍可正常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在確認你既有的權限之前，tessera 不會提示購買。你已儲存的主機仍可正常使用。"
          }
        }
      }
    },
