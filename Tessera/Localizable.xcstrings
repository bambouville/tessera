        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要裝置擁有者重新授權。"
          }
        }
      }
    },
    "A fresh device-owner check is required for every grant.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jede Freigabe ist eine erneute Gerätebesitz-Prüfung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada concesión requiere una nueva comprobación del propietario del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque autorisation exige une nouvelle vérification du propriétaire de l'appareil."
