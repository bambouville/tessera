    "Nothing changes until you confirm. Replacements preserve the prior fingerprint in Known Hosts for review.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu deiner Bestätigung ändert sich nichts. Bei Ersetzungen bleibt der frühere Fingerabdruck zur Prüfung unter „Bekannte Hosts“ erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada hasta que confirmes. Las sustituciones conservan la huella anterior en Hosts conocidos para que puedas revisarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change tant que vous n'avez pas confirmé. Les remplacements conservent l'empreinte précédente dans Hôtes connus pour vérification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するまで何も変更されません。置き換えを行っても、以前のフィンガープリントは確認できるよう「既知のホスト」に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
