        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私有材料現已從鑰匙圈中遺失。"
          }
        }
      }
    },
    "The private material stored under this key ID derives a different public key. Tessera will not restore sessions, authenticate, copy, or install it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das unter dieser Key-ID gespeicherte private Material ergibt einen anderen Public Key. Tessera stellt damit keine Sitzungen wieder her, authentifiziert sich nicht, kopiert und installiert ihn nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material privado guardado con este ID de clave deriva una clave pública distinta. Tessera no restaurará sesiones, ni se autenticará, ni lo copiará, ni lo instalará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matériel privé stocké sous cet identifiant de clé produit une clé publique différente. Tessera ne restaurera pas de session, ne s'authentifiera pas, ne le copiera pas et ne l'installera pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキー ID で保存されている秘密情報からは、別の公開鍵が導出されます。Tessera はこれを使ったセッションの復元・認証・コピー・設置のいずれも行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以此密钥 ID 存储的私密材料推导出的是另一个公钥。Tessera 不会用它恢复会话、认证、拷贝或安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以此金鑰 ID 儲存的私密材料推導出的是另一個公開金鑰。Tessera 不會用它回復工作階段、驗證、拷貝或安裝。"
          }
        }
      }
    },
    "The public key could not be installed on the host.": {
      "extractionState": "extracted_with_value",
