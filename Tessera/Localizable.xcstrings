    "Tessera found %lld Keychain items with no matching key metadata. They cannot be selected, authenticated with, exported, or associated with a host. This removes only those inaccessible orphaned items.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera hat %lld Schlüsselbund-Objekt ohne passende Key-Metadaten gefunden. Es lässt sich nicht auswählen, zur Authentifizierung nutzen, exportieren oder einem Host zuordnen. Entfernt werden nur diese unzugänglichen verwaisten Objekte."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera hat %lld Schlüsselbund-Objekte ohne passende Key-Metadaten gefunden. Sie lassen sich nicht auswählen, zur Authentifizierung nutzen, exportieren oder einem Host zuordnen. Entfernt werden nur diese unzugänglichen verwaisten Objekte."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera found %lld Keychain item with no matching key metadata. It cannot be selected, authenticated with, exported, or associated with a host. This removes only that inaccessible orphaned item."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera found %lld Keychain items with no matching key metadata. They cannot be selected, authenticated with, exported, or associated with a host. This removes only those inaccessible orphaned items."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera encontró %lld ítem del llavero sin metadatos de clave asociados. No se puede seleccionar, usar para autenticar, exportar ni asociar a un host. Esto elimina únicamente esos ítems huérfanos inaccesibles."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera encontró %lld ítems del llavero sin metadatos de clave asociados. No se pueden seleccionar, usar para autenticar, exportar ni asociar a un host. Esto elimina únicamente esos ítems huérfanos inaccesibles."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera a trouvé %lld élément du trousseau sans métadonnées de clé correspondantes. Il ne peut être ni sélectionné, ni utilisé pour s'authentifier, ni exporté, ni associé à un hôte. Seuls ces éléments orphelins inaccessibles sont supprimés."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera a trouvé %lld éléments du trousseau sans métadonnées de clé correspondantes. Ils ne peuvent être ni sélectionnés, ni utilisés pour s'authentifier, ni exportés, ni associés à un hôte. Seuls ces éléments orphelins inaccessibles sont supprimés."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "対応するキーのメタデータがないキーチェーン項目が %lld 件見つかりました。これらは選択・認証・書き出し・ホストへの関連付けのいずれもできません。この操作では、アクセスできない孤立した項目のみを削除します。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera 发现 %lld 个没有对应密钥元数据的钥匙串项目。它们无法被选择、用于认证、导出或关联到主机。此操作只会移除这些无法访问的孤立项目。"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tessera 發現 %lld 個沒有對應金鑰中繼資料的鑰匙圈項目。它們無法被選擇、用於驗證、輸出或關聯到主機。此操作只會移除這些無法存取的孤立項目。"
                }
              }
            }
          }
        }
      }
    },
    "Tessera is adding the approved public key to authorized_keys.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera trägt den freigegebenen Public Key in authorized_keys ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera está añadiendo la clave pública aprobada a authorized_keys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera ajoute la clé publique approuvée à authorized_keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera が承認された公開鍵を authorized_keys に追加しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 正在将已批准的公钥添加到 authorized_keys。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 正在將已核准的公鑰加入 authorized_keys。"
          }
        }
      }
    },
    "Tessera is creating or loading this device’s Secure Enclave key. If your key-use setting requires authentication, confirm Face ID or device passcode. You can change it later in Keys.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera erzeugt oder lädt den Secure-Enclave-Key dieses Geräts. Verlangt deine Einstellung zur Key-Nutzung eine Authentifizierung, bestätige mit Face ID oder dem Gerätecode. Du kannst das später unter „Keys“ ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera está creando o cargando la clave del Secure Enclave de este dispositivo. Si tu ajuste de uso de claves exige autenticación, confirma con Face ID o el código del dispositivo. Puedes cambiarlo luego en Claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera crée ou charge la clé Secure Enclave de cet appareil. Si votre réglage d'utilisation des clés exige une authentification, confirmez avec Face ID ou le code de l'appareil. Vous pourrez le modifier plus tard dans Clés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera がこのデバイスの Secure Enclave キーを作成または読み込んでいます。キー使用時の設定で認証が必要な場合は、Face ID かデバイスのパスコードで確認してください。設定はあとから「キー」で変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 正在创建或载入本设备的 Secure Enclave 密钥。如果你的密钥使用设置要求认证，请用 Face ID 或设备密码确认。之后可以在「密钥」中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 正在製作或載入本裝置的 Secure Enclave 金鑰。如果你的金鑰使用設定要求驗證，請用 Face ID 或裝置密碼確認。之後可以在「金鑰」中更改。"
          }
        }
      }
    },
    "Tessera preserves other shell configurations and only sources its provider shims into bash or zsh.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera lässt andere Shell-Konfigurationen unangetastet und bindet seine Provider-Shims nur in bash oder zsh ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera conserva otras configuraciones de shell y solo carga sus shims de proveedor en bash o zsh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera préserve les autres configurations de shell et ne charge ses shims de fournisseur que dans bash ou zsh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera は他のシェル設定をそのまま保ち、プロバイダのシムは bash または zsh にのみ読み込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 会保留其他 shell 配置，仅把其提供方垫片加载到 bash 或 zsh 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 會保留其他 shell 設定，僅把其提供者墊片載入到 bash 或 zsh 中。"
          }
        }
      }
    },
    "Tessera will create a standard passphrase-encrypted OpenSSH private-key file. Tessera cannot recover this passphrase. No plaintext key file is created.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera erstellt eine standardmäßige, mit Passphrase verschlüsselte OpenSSH-Private-Key-Datei. Tessera kann diese Passphrase nicht wiederherstellen. Es wird keine Klartext-Key-Datei erzeugt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera creará un archivo de clave privada OpenSSH estándar cifrado con frase de contraseña. Tessera no puede recuperar esa frase. No se crea ningún archivo de clave en texto plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera créera un fichier de clé privée OpenSSH standard chiffré par phrase secrète. Tessera ne peut pas récupérer cette phrase secrète. Aucun fichier de clé en clair n'est créé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera は、パスフレーズで暗号化された標準的な OpenSSH 秘密鍵ファイルを作成します。このパスフレーズを Tessera が復元することはできません。平文の鍵ファイルは作成されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 将创建一个标准的、用口令加密的 OpenSSH 私钥文件。Tessera 无法找回该口令。不会生成任何明文密钥文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 將建立一個標準的、以密語加密的 OpenSSH 私鑰檔案。Tessera 無法找回該密語。不會產生任何明文金鑰檔案。"
          }
        }
      }
    },
    "Tessera will not paste into the terminal. When the upload finishes, its remote path will be copied to the clipboard instead.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera setzt nichts in das Terminal ein. Wenn der Upload abgeschlossen ist, wird stattdessen der entfernte Pfad in die Zwischenablage kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera no pegará nada en el terminal. Cuando finalice la subida, la ruta remota se copiará en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera ne collera rien dans le terminal. Une fois le téléversement terminé, le chemin distant sera copié dans le presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera はターミナルにペーストしません。アップロードが完了すると、代わりにリモートパスがクリップボードにコピーされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 不会将内容粘贴到终端。上传完成后，远程路径将改为复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera 不會將內容貼到終端機。上傳完成後，遠端路徑將改為複製到剪貼簿。"
          }
        }
      }
    },
    "Tessera will recheck when the foreground program returns to its shell.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera prüft erneut, sobald das Vordergrundprogramm zur Shell zurückkehrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera volverá a comprobarlo cuando el programa en primer plano regrese a su shell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera revérifiera lorsque le programme au premier plan reviendra à son shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォアグラウンドのプログラムがシェルに戻ると、Tessera が再確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前台程序回到 shell 后，Tessera 会重新检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前景程式回到 shell 後，Tessera 會重新檢查。"
          }
        }
      }
    },
    "The Keychain returned an unexpected result.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund hat ein unerwartetes Ergebnis geliefert."
          }
