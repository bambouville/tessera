    "cwd-follow shell integration lives in the Files panel. when no directory signal exists, the panel shows an Install button there.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Shell-Integration für das Mitlaufen des Arbeitsverzeichnisses sitzt im Dateibereich. Fehlt ein Verzeichnissignal, zeigt der Bereich dort eine Schaltfläche „Installieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la integración con el shell que sigue el directorio actual está en el panel de archivos. cuando no hay ninguna señal de directorio, el panel muestra allí un botón Instalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "l'intégration au shell qui suit le répertoire courant se trouve dans le panneau de fichiers. en l'absence de signal de répertoire, le panneau y affiche un bouton Installer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレントディレクトリに追従するシェル統合は、「ファイル」パネルにあります。ディレクトリの信号がない場合、パネルにインストールボタンが表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随当前目录的 shell 集成位于文件面板中。当没有目录信号时，面板会在那里显示「安装」按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨目前目錄的 shell 整合位於檔案面板中。當沒有目錄訊號時，面板會在那裡顯示「安裝」按鈕。"
          }
        }
      }
    },
