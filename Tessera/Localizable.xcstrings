    "A fast iPad terminal for SSH & Mosh — trackpad scrolling in TUIs, native tmux, truecolor, edge-to-edge. Want a quick tour?": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schnelles iPad-Terminal für SSH & Mosh — Trackpad-Scrollen in TUIs, natives tmux, Truecolor, randlos. Lust auf eine kurze Tour?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal rápido para iPad con SSH y Mosh: desplazamiento con trackpad en TUI, tmux nativo, truecolor y de borde a borde. ¿Quieres un recorrido rápido?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal iPad rapide pour SSH et Mosh — défilement au trackpad dans les TUI, tmux natif, truecolor, bord à bord. Envie d'une visite rapide ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH と mosh のための高速な iPad ターミナル — TUI でのトラックパッドスクロール、ネイティブ tmux、トゥルーカラー、画面いっぱいの表示。簡単なツアーをご覧になりますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 SSH 和 mosh 打造的快速 iPad 终端 —— TUI 中的触控板滚动、原生 tmux、真彩色、全屏显示。要快速浏览一下吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 SSH 和 mosh 打造的快速 iPad 終端機 —— TUI 中的觸控板捲動、原生 tmux、全彩、全螢幕顯示。要快速導覽一下嗎？"
          }
        }
      }
    },
    "A fast terminal for SSH & Mosh — native tmux, remote files, agent-aware controls, and a keyboard built for your phone. Want a quick tour?": {
