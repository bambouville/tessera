        }
      }
    },
    "The continuation tmux session name contains unsafe characters.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der tmux-Sitzungsname der Fortsetzung enthält unsichere Zeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de la sesión de tmux de la continuación contiene caracteres no seguros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de session tmux de la reprise contient des caractères non sûrs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "継続用の tmux セッション名に安全でない文字が含まれています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
