    "Open Files from the terminal top bar to browse, download, and Quick Look remote files. SSH, tmux, and mosh sessions share the same file tools.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Dateien über die obere Terminalleiste, um entfernte Dateien zu durchsuchen, herunterzuladen und per Quick Look anzusehen. SSH-, tmux- und mosh-Sitzungen nutzen dieselben Dateiwerkzeuge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Archivos desde la barra superior del terminal para explorar, descargar y previsualizar archivos remotos. Las sesiones SSH, tmux y mosh comparten las mismas herramientas de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Fichiers depuis la barre supérieure du terminal pour parcourir, télécharger et prévisualiser des fichiers distants. Les sessions SSH, tmux et mosh partagent les mêmes outils de fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル上部バーからファイルを開くと、リモートファイルの閲覧・ダウンロード・クイックルックができます。SSH、tmux、mosh のセッションはいずれも同じファイルツールを共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从终端顶栏打开“文件”即可浏览、下载并快速查看远程文件。SSH、tmux 与 mosh 会话共用同一套文件工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從終端機頂部列開啟「檔案」即可瀏覽、下載並預覽遠端檔案。SSH、tmux 與 mosh 工作階段共用同一套檔案工具。"
          }
        }
      }
    },
