        }
      }
    },
    "the puck remembers its last position per-orientation. this is just the cold-launch fallback.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Puck merkt sich seine letzte Position je Ausrichtung. Dies ist nur der Rückfall beim Kaltstart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el disco recuerda su última posición en cada orientación. esto es solo el valor de reserva al arrancar en frío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la pastille retient sa dernière position pour chaque orientation. ceci n'est que la valeur de repli au démarrage à froid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パックは向きごとに最後の位置を記憶します。これはコールド起動時のフォールバックにすぎません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆钮会按屏幕方向分别记住上次的位置。这里设置的只是冷启动时的回退值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓鈕會依螢幕方向分別記住上次的位置。這裡設定的只是冷啟動時的回退值。"
          }
        }
      }
    },
    "the same server-side screen remains attached on both devices.": {
