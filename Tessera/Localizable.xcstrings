    "The receiving device will trust the same server keys without prompting again. Existing conflicts are preserved for review.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das empfangende Gerät vertraut denselben Server-Keys ohne erneute Nachfrage. Bestehende Konflikte bleiben zur Prüfung erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo receptor confiará en las mismas claves de servidor sin volver a preguntar. Los conflictos existentes se conservan para revisarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil destinataire fera confiance aux mêmes clés de serveur sans redemander. Les conflits existants sont conservés pour vérification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信側のデバイスは、同じサーバーキーを再確認なしで信頼します。既存の競合は確認できるよう保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收设备将信任相同的服务器密钥，不再询问。已有的冲突会被保留以供查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接收裝置將信任相同的伺服器金鑰，不再詢問。既有的衝突會被保留以供查看。"
          }
        }
      }
    },
