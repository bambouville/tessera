          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer mosh. L'hôte n'a peut-être pas `mosh-server` installé ou dans le PATH, ou il s'est arrêté aussitôt au démarrage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh を開始できませんでした。リモートホストに `mosh-server` がインストールされていないか PATH にないか、起動直後に終了した可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 mosh。远程主机可能未安装 `mosh-server` 或它不在 PATH 中，也可能在启动时立即退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動 mosh。遠端主機可能未安裝 `mosh-server` 或不在 PATH 中，也可能在啟動時立即結束。"
          }
        }
