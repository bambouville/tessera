      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh konnte nicht gestartet werden. Auf dem Host ist `mosh-server` möglicherweise nicht installiert oder nicht im PATH, oder er wurde beim Start sofort beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
