        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne und wechsle tmux-Fenster über die obere Leiste. Geteilte Bereiche bleiben erhalten, während der fokussierte Bereich in den Bildschirm passt."
          }
        },
        "es": {
