    },
    "The actual Keychain boundary currently requires biometrics (Face ID/Touch ID) or passcode.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die tatsächliche Schlüsselbund-Grenze verlangt derzeit Biometrie (Face ID/Touch ID) oder Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite real del llavero requiere actualmente biometría (Face ID/Touch ID) o código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite réelle du trousseau exige actuellement la biométrie (Face ID/Touch ID) ou le code."
          }
        },
        "ja": {
