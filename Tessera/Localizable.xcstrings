    "Host files may have changed, but this shell was not enabled. Recheck from an empty shell prompt.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Host haben sich vielleicht Dateien geändert, aber diese Shell wurde nicht aktiviert. Prüfe erneut an einer leeren Shell-Eingabeaufforderung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que los archivos del host hayan cambiado, pero este shell no se activó. Vuelve a comprobarlo desde un prompt de shell vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de l'hôte ont peut-être changé, mais ce shell n'a pas été activé. Revérifiez depuis une invite shell vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト上のファイルは変更された可能性がありますが、このシェルは有効化されていません。空のシェルプロンプトから再確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机文件可能已更改，但此 shell 未被启用。请在空的 shell 提示符下重新检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機檔案可能已變更，但此 shell 未被啟用。請在空白的 shell 提示字元下重新檢查。"
          }
        }
      }
    },
    "Host key was not trusted. Connect once first to review it, then retry.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Host-Key wurde nicht vertraut. Verbinde dich zunächst einmal, um ihn zu prüfen, und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confió en la clave del host. Conecta una vez para revisarla y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d'hôte n'a pas été approuvée. Connectez-vous une fois pour la vérifier, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストキーが信頼されていません。まず一度接続して内容を確認してから、やり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未信任该主机密钥。请先连接一次以核对，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未信任該主機金鑰。請先連線一次以核對，然後重試。"
          }
        }
      }
    },
