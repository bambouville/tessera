        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析跳板主機鏈。"
          }
        }
      }
    },
    "The key body is never displayed or sent through a keyboard input surface.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Key-Inhalt wird nie angezeigt und nie über eine Tastatureingabe geleitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuerpo de la clave nunca se muestra ni pasa por una superficie de entrada de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps de la clé n'est jamais affiché ni transmis via une surface de saisie clavier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー本体が表示されたり、キーボード入力の経路を通ったりすることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥主体绝不会被显示，也不会经由键盘输入界面传递。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰主體絕不會被顯示，也不會經由鍵盤輸入介面傳遞。"
          }
        }
      }
    },
    "The key metadata could not be saved (%@), and secure cleanup also failed (%@). No success was reported.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Key-Metadaten konnten nicht gesichert werden (%@), und auch die sichere Bereinigung ist fehlgeschlagen (%@). Es wurde kein Erfolg gemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los metadatos de la clave (%@) y la limpieza segura también falló (%@). No se informó de ningún éxito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de la clé n'ont pas pu être enregistrées (%@) et le nettoyage sécurisé a également échoué (%@). Aucun succès n'a été signalé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのメタデータを保存できず（%@）、安全な後始末にも失敗しました（%@）。成功は報告されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存密钥元数据（%@），安全清理也失败了（%@）。未报告任何成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存金鑰中繼資料（%@），安全清理也失敗了（%@）。未回報任何成功。"
          }
        }
      }
    },
    "The key metadata could not be saved, so the Keychain protection change was reversed. %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Key-Metadaten konnten nicht gesichert werden, daher wurde die Änderung des Schlüsselbund-Schutzes zurückgenommen. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los metadatos de la clave, así que se revirtió el cambio de protección del llavero. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de la clé n'ont pas pu être enregistrées, le changement de protection du trousseau a donc été annulé. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのメタデータを保存できなかったため、キーチェーンの保護設定の変更を取り消しました。%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存密钥元数据，因此已撤销钥匙串保护的更改。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存金鑰中繼資料，因此已撤銷鑰匙圈保護的更改。%@"
          }
        }
      }
    },
    "The key metadata could not be saved. Secure key material was removed. %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Key-Metadaten konnten nicht gesichert werden. Das sichere Key-Material wurde entfernt. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los metadatos de la clave. Se eliminó el material seguro de la clave. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de la clé n'ont pas pu être enregistrées. Le matériel de clé sécurisé a été supprimé. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのメタデータを保存できませんでした。安全に保管されていたキー情報は削除されました。%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存密钥元数据。安全存放的密钥材料已被移除。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存金鑰中繼資料。安全存放的金鑰材料已被移除。%@"
          }
        }
      }
    },
    "The key operation failed (%@) and its recovery action also failed (%@).": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Key-Vorgang ist fehlgeschlagen (%@), und auch die zugehörige Wiederherstellung ist fehlgeschlagen (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación con la clave falló (%@) y su acción de recuperación también falló (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération sur la clé a échoué (%@) et son action de récupération a également échoué (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの操作に失敗し（%@）、その回復処理も失敗しました（%@）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥操作失败（%@），其恢复动作也失败了（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰操作失敗（%@），其回復動作也失敗了（%@）。"
          }
        }
      }
    },
    "The key remains hardware-bound. Tessera enforces this authentication setting before key use, so you can change it later.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Key bleibt hardwaregebunden. Tessera erzwingt diese Authentifizierungseinstellung vor jeder Nutzung, du kannst sie also später ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave sigue vinculada al hardware. Tessera aplica este ajuste de autenticación antes de usarla, así que puedes cambiarlo más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé reste liée au matériel. Tessera applique ce réglage d'authentification avant chaque utilisation, vous pourrez donc le modifier plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはハードウェアに固定されたままです。Tessera はキーを使う前にこの認証設定を適用するため、あとから変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该密钥仍绑定硬件。Tessera 会在使用密钥前应用此认证设置，因此你之后仍可更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該金鑰仍綁定硬體。Tessera 會在使用金鑰前套用此驗證設定，因此你之後仍可更改。"
          }
        }
      }
    },
    "The keyboard bar keeps Escape, arrows, Tab, Control, and other shell keys within reach. Tap a modifier once for the next key, or twice to lock it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastaturleiste hält Escape, Pfeiltasten, Tab, Control und weitere Shell-Tasten griffbereit. Tippe einen Modifier einmal für die nächste Taste an oder zweimal, um ihn festzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de teclado mantiene a mano Escape, flechas, Tab, Control y otras teclas del shell. Toca un modificador una vez para la siguiente tecla o dos veces para fijarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre clavier garde Échap, les flèches, Tab, Control et les autres touches shell à portée de main. Touchez un modificateur une fois pour la touche suivante, ou deux fois pour le verrouiller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードバーには Escape、矢印キー、Tab、Control などのシェルキーが並びます。修飾キーは 1 回タップで次のキーのみ、2 回タップでロックできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘栏把 Escape、方向键、Tab、Control 等 shell 按键放在手边。轻点一次修饰键作用于下一个按键，轻点两次可锁定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤列把 Escape、方向鍵、Tab、Control 等 shell 按鍵放在手邊。輕點一次修飾鍵套用到下一個按鍵，輕點兩次可鎖定。"
          }
        }
      }
    },
    "The local device key has invalid public metadata.": {
