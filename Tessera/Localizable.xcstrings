    "“%@” contains %lld panes. Closing this window will close every pane in it.": {
      "comment": "Close confirmation. Pluralized on the pane count.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält %lld Bereiche. Beim Schließen dieses Fensters werden alle darin enthaltenen Bereiche geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contiene %lld paneles. Cerrar esta ventana cerrará todos sus paneles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » contient %lld volets. Fermer cette fenêtre fermera tous ses volets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」には %2$lld 個のペインがあります。このウインドウを閉じると、その中のペインもすべて閉じられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」包含 %2$lld 个窗格。关闭此窗口会一并关闭其中所有窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」包含 %2$lld 個窗格。關閉此視窗會一併關閉其中所有窗格。"
          }
        }
      }
    },
    "“%@” is still syncing its pane layout. Closing this window will close every pane it contains.": {
      "comment": "Close confirmation while the pane count is still unknown.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ synchronisiert noch seine Bereichsaufteilung. Beim Schließen dieses Fensters werden alle darin enthaltenen Bereiche geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» todavía está sincronizando la disposición de sus paneles. Cerrar esta ventana cerrará todos los paneles que contenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » synchronise encore la disposition de ses volets. Fermer cette fenêtre fermera tous les volets qu'elle contient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はまだペインの配置を同期しています。このウインドウを閉じると、含まれるペインもすべて閉じられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」仍在同步窗格布局。关闭此窗口会一并关闭其中包含的所有窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」仍在同步窗格版面。關閉此視窗會一併關閉其中包含的所有窗格。"
          }
        }
      }
    },
