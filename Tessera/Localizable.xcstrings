          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "todavía nada: un atajo personalizado envía texto o teclas al remoto, desde una combinación, desde una ficha de la barra, o desde ambas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "rien pour l'instant — un raccourci personnalisé envoie du texte ou des touches à la machine distante, depuis une combinaison, une pastille de la barre, ou les deux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
