    "stored only in this device's keychain — never synced": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nur im Schlüsselbund dieses Geräts gesichert – wird nie synchronisiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se guarda solo en el llavero de este dispositivo, nunca se sincroniza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "conservé uniquement dans le trousseau de cet appareil — jamais synchronisé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのキーチェーンにのみ保存され、同期されることはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在本设备的钥匙串中 —— 绝不同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存在本裝置的鑰匙圈中 —— 絕不同步"
          }
        }
      }
    },
    "stored only in this device's keychain — never synced and never sent to the other device": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nur im Schlüsselbund dieses Geräts gesichert – wird nie synchronisiert und nie an das andere Gerät gesendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se guarda solo en el llavero de este dispositivo: nunca se sincroniza ni se envía al otro dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "conservé uniquement dans le trousseau de cet appareil — jamais synchronisé ni envoyé à l'autre appareil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのキーチェーンにのみ保存され、同期されることも、もう一方のデバイスに送られることもありません"
