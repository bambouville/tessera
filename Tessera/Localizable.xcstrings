    "RSA import is disabled because the current SSH stack can only offer the deprecated RSA/SHA-1 signature. Use Ed25519 instead.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der RSA-Import ist deaktiviert, weil der aktuelle SSH-Stack nur die veraltete RSA/SHA-1-Signatur anbieten kann. Verwende stattdessen Ed25519."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación de RSA está desactivada porque la pila SSH actual solo puede ofrecer la firma obsoleta RSA/SHA-1. Usa Ed25519 en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'import RSA est désactivé car la pile SSH actuelle ne peut proposer que la signature obsolète RSA/SHA-1. Utilisez Ed25519 à la place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の SSH スタックは非推奨の RSA/SHA-1 署名しか提示できないため、RSA の読み込みは無効です。代わりに Ed25519 を使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于当前 SSH 栈只能提供已弃用的 RSA/SHA-1 签名，RSA 导入已停用。请改用 Ed25519。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於目前 SSH 堆疊只能提供已棄用的 RSA/SHA-1 簽章，RSA 輸入已停用。請改用 Ed25519。"
          }
        }
      }
    },
