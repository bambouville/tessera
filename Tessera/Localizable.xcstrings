    "On that device, open Settings → Continuity and tap “send setup to nearby device.”": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf jenem Gerät „Einstellungen“ → „Kontinuität“ und tippe auf „Einrichtung an Gerät in der Nähe senden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
