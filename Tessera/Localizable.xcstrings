    "Software-backed simulator key. It is not protected by Secure Enclave; grant access only to test hosts you intend this simulator to use.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software-basierter Simulator-Key. Er ist nicht durch die Secure Enclave geschützt — gib nur Testhosts frei, die dieser Simulator verwenden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de simulador basada en software. No está protegida por Secure Enclave; concede acceso solo a hosts de prueba que quieras usar desde este simulador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé de simulateur logicielle. Elle n'est pas protégée par la Secure Enclave : n'accordez l'accès qu'à des hôtes de test destinés à ce simulateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトウェアベースのシミュレータキーです。Secure Enclave では保護されません。このシミュレータで使うテスト用ホストにのみアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于软件的模拟器密钥。它不受安全隔区保护；请只授权给你打算在此模拟器上使用的测试主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
