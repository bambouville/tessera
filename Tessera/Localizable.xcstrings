      }
    },
    "The upload stopped because iOS background time expired.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload wurde beendet, weil die iOS-Hintergrundzeit abgelaufen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La subida se detuvo porque se agotó el tiempo de ejecución en segundo plano de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléversement s'est arrêté, car le temps d'exécution en arrière-plan accordé par iOS a expiré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS のバックグラウンド実行時間が終了したため、アップロードを停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 iOS 后台运行时间已到，上传已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於 iOS 背景執行時間已到，上傳已停止。"
          }
        }
      }
    },
    "The upload stopped, but cleanup of the temporary remote file will retry on the next connection: %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload wurde beendet, aber die temporäre entfernte Datei wird bei der nächsten Verbindung erneut bereinigt: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La subida se detuvo, pero se volverá a intentar limpiar el archivo remoto temporal en la próxima conexión: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléversement s'est arrêté, mais le nettoyage du fichier distant temporaire sera retenté à la prochaine connexion : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードを停止しましたが、一時リモートファイルの削除は次回の接続時に再試行されます: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传已停止，但下次连接时会再次尝试清理临时远程文件：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳已停止，但下次連線時會再次嘗試清理暫存遠端檔案：%@"
          }
        }
      }
    },
    "The uploaded path was copied to the clipboard because the terminal did not connect.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der hochgeladene Pfad wurde in die Zwischenablage kopiert, weil das Terminal keine Verbindung hergestellt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta del archivo subido se copió en el portapapeles porque el terminal no se conectó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin du fichier téléversé a été copié dans le presse-papiers, car le terminal ne s'est pas connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルが接続されなかったため、アップロードしたパスをクリップボードにコピーしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于终端未连接，已上传的路径已复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於終端機未連線，已上傳的路徑已複製到剪貼簿。"
          }
        }
      }
    },
    "These fields may contain secrets or change first-connect trust. Select only what you intend to copy to %@.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Felder können Geheimnisse enthalten oder das Vertrauen beim ersten Verbinden verändern. Wähle nur aus, was du wirklich auf %@ kopieren willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos campos pueden contener secretos o alterar la confianza en la primera conexión. Selecciona solo lo que quieras copiar a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces champs peuvent contenir des secrets ou modifier la confiance à la première connexion. Ne sélectionnez que ce que vous voulez copier vers %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目には機密情報が含まれる、または初回接続時の信頼に影響する可能性があります。%@ にコピーしたいものだけを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些字段可能包含机密信息，或改变首次连接的信任关系。请只选择你确实要复制到 %@ 的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些欄位可能包含機密資訊，或改變首次連線的信任關係。請只選擇你確實要複製到 %@ 的內容。"
          }
        }
      }
    },
    "This Secure Enclave key can never be recovered after device loss. Before installing it remotely, keep a second recoverable credential on that host.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Secure-Enclave-Key lässt sich nach einem Geräteverlust nie wiederherstellen. Halte auf dem Host einen zweiten, wiederherstellbaren Zugang bereit, bevor du ihn dort installierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave del Secure Enclave no se puede recuperar nunca tras perder el dispositivo. Antes de instalarla en remoto, deja una segunda credencial recuperable en ese host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé Secure Enclave ne pourra jamais être récupérée après la perte de l'appareil. Avant de l'installer à distance, gardez un second identifiant récupérable sur cet hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Secure Enclave キーは、デバイスを紛失すると二度と復旧できません。リモートに設置する前に、そのホストに復旧可能な 2 つ目の資格情報を用意しておいてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Secure Enclave 密钥在设备丢失后永远无法恢复。远程安装前，请在该主机上保留第二个可恢复的凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Secure Enclave 金鑰在裝置遺失後永遠無法回復。遠端安裝前，請在該主機上保留第二個可回復的憑證。"
          }
        }
      }
    },
    "This Secure Enclave key is permanently unrecoverable after deletion.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Secure-Enclave-Key ist nach dem Löschen dauerhaft unwiederbringlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave del Secure Enclave será irrecuperable de forma permanente tras eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé Secure Enclave sera définitivement irrécupérable après suppression."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Secure Enclave キーは、削除すると二度と復元できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Secure Enclave 密钥一旦删除将永久无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Secure Enclave 金鑰一旦刪除將永久無法復原。"
          }
        }
      }
    },
    "This eligible host was not included in the approved batch.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser infrage kommende Host war nicht Teil der bestätigten Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este host apto no se incluyó en el lote aprobado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet hôte éligible n'était pas inclus dans le lot approuvé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象となり得るこのホストは、承認されたまとまりに含まれていませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台符合条件的主机未包含在已批准的批次中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台符合條件的主機未包含在已核准的批次中。"
          }
        }
      }
    },
    "This handshake attempt has already been consumed.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Handshake-Versuch wurde bereits verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este intento de handshake ya se ha consumido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tentative de handshake a déjà été consommée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このハンドシェイクはすでに使用済みです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次握手尝试已被使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此次交握嘗試已被使用。"
          }
        }
      }
    },
    "This host is no longer configured to authenticate with the key being revoked.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Host ist nicht mehr so eingerichtet, dass er sich mit dem zu widerrufenden Key authentifiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este host ya no está configurado para autenticarse con la clave que se está revocando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet hôte n'est plus configuré pour s'authentifier avec la clé en cours de révocation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストは、失効させようとしているキーで認証する設定ではなくなっています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机已不再配置为使用正被吊销的密钥进行认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此主機已不再設定為使用正被撤銷的金鑰進行驗證。"
          }
        }
      }
    },
    "This host or jump route changed after authorization. Review the saved route before changing remote access.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Host oder die Jump-Route hat sich nach der Autorisierung geändert. Prüfe die gesicherte Route, bevor du den entfernten Zugang änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este host o su ruta de saltos cambió después de la autorización. Revisa la ruta guardada antes de cambiar el acceso remoto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet hôte ou sa route de rebonds a changé après l'autorisation. Vérifiez la route enregistrée avant de modifier l'accès distant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証後に、このホストまたは踏み台経路が変更されました。リモートアクセスを変更する前に、保存済みの経路を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权之后此主机或跳板路由发生了变化。更改远程访问权限前请先核对已保存的路由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權之後此主機或跳板路由發生了變化。更改遠端存取權限前請先核對已儲存的路由。"
          }
        }
      }
    },
    "This host uses this key for authentication. Choose a host identity that uses a different key or password.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Host nutzt diesen Key zur Authentifizierung. Wähle eine Host-Identität, die einen anderen Key oder ein Passwort verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este host usa esta clave para autenticarse. Elige una identidad de host que use otra clave o una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet hôte utilise cette clé pour s'authentifier. Choisissez une identité d'hôte qui utilise une autre clé ou un mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストは、このキーを認証に使用しています。別のキーまたはパスワードを使うホスト識別情報を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机使用该密钥进行认证。请选择使用其他密钥或密码的主机身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此主機使用該金鑰進行驗證。請選擇使用其他金鑰或密碼的主機身分。"
          }
        }
      }
    },
    "This host's key isn't trusted yet. Open a terminal session to it first to review the key, then retry.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Key dieses Hosts wird noch nicht vertraut. Öffne zuerst eine Terminal-Sitzung dorthin, um den Key zu prüfen, und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se confía en la clave de este host. Abre primero una sesión de terminal para revisarla y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de cet hôte n'est pas encore approuvée. Ouvrez d'abord une session de terminal pour la vérifier, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストのキーはまだ信頼されていません。先にターミナルセッションを開いてキーを確認してから、やり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未信任此主机的密钥。请先打开一个终端会话核对密钥，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未信任此主機的金鑰。請先打開一個終端機工作階段核對金鑰，然後重試。"
          }
        }
      }
    },
    "This is the acknowledged result for every host. Failed, skipped, and credential-ineligible hosts are never reported as authorized.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das bestätigte Ergebnis für jeden Host. Fehlgeschlagene, übersprungene und für Anmeldedaten ungeeignete Hosts werden nie als autorisiert gemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el resultado confirmado de cada host. Los hosts fallidos, omitidos o no aptos por credenciales nunca se informan como autorizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici le résultat confirmé pour chaque hôte. Les hôtes en échec, ignorés ou inéligibles côté identifiants ne sont jamais signalés comme autorisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは各ホストについて確認済みの結果です。失敗・スキップ・認証情報の要件を満たさないホストが承認済みとして報告されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是每台主机的确认结果。失败、跳过以及不符合凭据条件的主机绝不会被报告为已授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是每台主機的確認結果。失敗、略過以及不符合憑證條件的主機絕不會被回報為已授權。"
          }
        }
      }
    },
    "This keeps future agent status accurate in Agent Center.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So bleibt der Agentenstatus im Agent Center künftig korrekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así el estado de los agentes se mantiene preciso en el Centro de agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état des agents reste ainsi exact dans le Centre des agents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、Agent Center でのエージェントの状態が今後も正確になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样可以让智能体中心中的状态在今后保持准确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這樣可以讓智慧體中心的狀態在日後保持準確。"
          }
        }
      }
    },
    "This key has tracked access for an earlier version of the host route. Revoke or resolve that access before requesting a new grant.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Key ist Zugang zu einer früheren Fassung der Host-Route erfasst. Widerrufe oder kläre diesen Zugang, bevor du eine neue Freigabe anforderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave tiene acceso registrado para una versión anterior de la ruta del host. Revoca o resuelve ese acceso antes de solicitar una nueva concesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé possède un accès suivi pour une version antérieure de la route d'hôte. Révoquez ou résolvez cet accès avant de demander une nouvelle autorisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーには、以前のバージョンのホスト経路に対する記録済みアクセスがあります。新しい付与を要求する前に、そのアクセスを失効させるか解消してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥在主机路由的早期版本上有已记录的访问权限。请先吊销或处理该权限，再申请新的授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金鑰在主機路由的早期版本上有已記錄的存取權限。請先撤銷或處理該權限，再申請新的授權。"
          }
        }
      }
    },
    "This key is still protected by iOS while authentication is off. Open Keys and choose ‘finish turning protection off’ before using it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Key wird weiterhin von iOS geschützt, obwohl die Authentifizierung aus ist. Öffne „Keys“ und wähle „Schutz endgültig deaktivieren“, bevor du ihn verwendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave sigue protegida por iOS aunque la autenticación esté desactivada. Abre Claves y elige «terminar de desactivar la protección» antes de usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est toujours protégée par iOS alors que l'authentification est désactivée. Ouvrez Clés et choisissez « terminer la désactivation de la protection » avant de l'utiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証がオフでも、このキーはまだ iOS によって保護されています。使用する前に「キー」を開き、「保護の解除を完了」を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即便认证已关闭，此密钥仍受 iOS 保护。使用前请打开「密钥」并选择「完成关闭保护」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即便驗證已關閉，此金鑰仍受 iOS 保護。使用前請打開「金鑰」並選擇「完成關閉保護」。"
          }
        }
      }
    },
    "This key is still protected by iOS. Confirm once to finish turning protection off, then Tessera can use it without authentication.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Key wird weiterhin von iOS geschützt. Bestätige einmal, um den Schutz vollständig zu deaktivieren; danach kann Tessera ihn ohne Authentifizierung verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave sigue protegida por iOS. Confirma una vez para terminar de desactivar la protección y Tessera podrá usarla sin autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est encore protégée par iOS. Confirmez une fois pour terminer la désactivation de la protection ; Tessera pourra ensuite l'utiliser sans authentification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーはまだ iOS によって保護されています。一度確認すると保護の解除が完了し、認証なしで Tessera が使用できるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥仍受 iOS 保护。确认一次即可完成关闭保护，之后 Tessera 无需认证即可使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金鑰仍受 iOS 保護。確認一次即可完成關閉保護，之後 Tessera 無需驗證即可使用它。"
          }
        }
      }
    },
    "This legacy development-key identity is unavailable. Replace it with a Keychain-backed key before connecting.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese veraltete Entwicklungs-Key-Identität ist nicht verfügbar. Ersetze sie vor dem Verbinden durch einen Key aus dem Schlüsselbund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta identidad de clave de desarrollo heredada no está disponible. Sustitúyela por una clave respaldada por el llavero antes de conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette identité de clé de développement héritée est indisponible. Remplacez-la par une clé stockée dans le trousseau avant de vous connecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この旧式の開発用キー識別情報は利用できません。接続する前に、キーチェーンに保存されたキーに差し替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此旧式开发密钥身份不可用。请在连接前换成由钥匙串保管的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此舊式開發金鑰身分不可用。請在連線前換成由鑰匙圈保管的金鑰。"
          }
        }
      }
    },
    "This legacy software key type cannot be exported safely by this version. Generate a recoverable Ed25519 key, install it alongside this credential, then retire this key.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser veraltete Software-Key-Typ lässt sich in dieser Version nicht sicher exportieren. Erzeuge einen wiederherstellbaren Ed25519-Key, installiere ihn neben diesem Zugang und nimm diesen Key anschließend außer Betrieb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no puede exportar de forma segura este tipo de clave por software heredado. Genera una clave Ed25519 recuperable, instálala junto a esta credencial y luego retira esta clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne peut pas exporter ce type de clé logicielle hérité en toute sécurité. Générez une clé Ed25519 récupérable, installez-la à côté de cet identifiant, puis retirez cette clé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは、この旧式のソフトウェアキーを安全に書き出せません。復旧可能な Ed25519 キーを生成し、この資格情報と併せて設置してから、このキーを廃止してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法安全导出这种旧式软件密钥。请生成一个可恢复的 Ed25519 密钥，与此凭据一并安装，然后停用此密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本無法安全輸出這種舊式軟體金鑰。請產生一個可回復的 Ed25519 金鑰，與此憑證一併安裝，然後停用此金鑰。"
          }
        }
      }
    },
    "This older Secure Enclave key requires rotation to change authentication": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Authentifizierung zu ändern, muss dieser ältere Secure-Enclave-Key ersetzt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar la autenticación hay que rotar esta clave antigua del Secure Enclave"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour changer l'authentification, cette ancienne clé Secure Enclave doit être remplacée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証方法を変更するには、この古い Secure Enclave キーを更新する必要があります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要更改认证方式，需要轮换此较早的 Secure Enclave 密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要更改驗證方式，需要輪換此較早的 Secure Enclave 金鑰"
          }
        }
      }
    },
    "This older ledger entry has no public key material; revoke it from the host manually": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser ältere Eintrag enthält kein Public-Key-Material; widerrufe ihn manuell auf dem Host"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entrada antigua del registro no tiene material de clave pública; revócala manualmente en el host"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ancienne entrée du registre ne contient pas de matériel de clé publique ; révoquez-la manuellement sur l'hôte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この古い記録には公開鍵の情報がありません。ホスト側で手動で失効させてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此较早的记录条目没有公钥材料；请在主机上手动吊销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此較早的記錄項目沒有公開金鑰材料；請在主機上手動撤銷"
          }
        }
      }
    },
    "This passphrase is used once to decrypt the selected file and is not retained. Tessera stores the imported key under the iOS protection selected below.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Passphrase wird einmal zum Entschlüsseln der gewählten Datei verwendet und nicht behalten. Tessera sichert den importierten Key mit dem unten gewählten iOS-Schutz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta frase de contraseña se usa una sola vez para descifrar el archivo seleccionado y no se conserva. Tessera guarda la clave importada con la protección de iOS elegida abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette phrase secrète sert une seule fois à déchiffrer le fichier sélectionné et n'est pas conservée. Tessera stocke la clé importée avec la protection iOS choisie ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスフレーズは、選択したファイルを復号するために一度だけ使われ、保持されません。読み込んだキーは、下で選んだ iOS の保護設定で保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码短语只用于解密所选文件一次，不会被保留。Tessera 会按下方选择的 iOS 保护级别存储导入的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此密碼短語只用於解密所選檔案一次，不會被保留。Tessera 會按下方選擇的 iOS 保護等級儲存輸入的金鑰。"
          }
        }
      }
    },
    "This permanently deletes the file on the host.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird die Datei auf dem Host dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el archivo del host de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement le fichier sur l'hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト上のファイルが完全に削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除主机上的该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除主機上的該檔案。"
          }
        }
      }
    },
    "This protection is enforced by iOS at the key boundary. It is separate from the recovery-file passphrase.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Schutz erzwingt iOS direkt am Key. Er ist unabhängig von der Passphrase der Wiederherstellungsdatei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS aplica esta protección en el propio límite de la clave. Es independiente de la frase de contraseña del archivo de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette protection est imposée par iOS au niveau de la clé elle-même. Elle est distincte de la phrase secrète du fichier de récupération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保護は、キーの境界で iOS が強制します。復旧ファイルのパスフレーズとは別のものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此保护由 iOS 在密钥边界处强制执行，与恢复文件的密码短语是两回事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此保護由 iOS 在金鑰邊界處強制執行，與回復檔案的密碼短語是兩回事。"
          }
        }
      }
    },
    "This recovery key does not match the selected key.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wiederherstellungs-Key passt nicht zum ausgewählten Key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave de recuperación no corresponde a la clave seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé de récupération ne correspond pas à la clé sélectionnée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この復旧キーは、選択したキーと一致しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此恢复密钥与所选密钥不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此回復金鑰與所選金鑰不符。"
          }
        }
      }
    },
    "This removes the saved host. Existing live sessions are not disconnected.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird der gesicherte Host entfernt. Laufende Sitzungen werden nicht getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el host guardado. Las sesiones activas no se desconectan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'hôte enregistré. Les sessions en cours ne sont pas déconnectées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたホストを削除します。実行中のセッションは切断されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除已保存的主机。正在运行的会话不会断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除已儲存的主機。進行中的工作階段不會中斷。"
          }
        }
      }
    },
    "This saved host no longer exists.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser gesicherte Host existiert nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este host guardado ya no existe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet hôte enregistré n'existe plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存済みホストはもう存在しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此已保存的主机已不存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此已儲存的主機已不存在。"
          }
        }
      }
    },
    "This session is being controlled from another device.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung wird von einem anderen Gerät gesteuert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "esta sesión se está controlando desde otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cette session est contrôlée depuis un autre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは別のデバイスから操作されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话正由另一台设备控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作階段正由另一台裝置控制。"
          }
        }
      }
    },
    "This software key has no recorded recovery export. Installing it as the only remote credential can permanently lock you out after device loss or accidental deletion.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Software-Key ist kein Wiederherstellungs-Export vermerkt. Wird er als einziger entfernter Zugang installiert, kannst du dich nach Geräteverlust oder versehentlichem Löschen dauerhaft aussperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave por software no tiene ninguna exportación de recuperación registrada. Instalarla como única credencial remota puede dejarte sin acceso de forma permanente si pierdes el dispositivo o la eliminas por error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé logicielle n'a aucun export de récupération enregistré. L'installer comme unique identifiant distant peut vous bloquer définitivement en cas de perte de l'appareil ou de suppression accidentelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソフトウェアキーには復旧ファイルの記録がありません。これを唯一のリモート資格情報として設置すると、デバイスの紛失や誤削除の後、恒久的にログインできなくなるおそれがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此软件密钥没有恢复文件导出记录。若将它作为唯一的远程凭据安装，设备丢失或误删后你可能被永久锁在门外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此軟體金鑰沒有回復檔案輸出記錄。若將它作為唯一的遠端憑證安裝，裝置遺失或誤刪後你可能被永久鎖在門外。"
          }
        }
      }
    },
    "This transfer was aborted; start a fresh transfer.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übertragung wurde abgebrochen — starte eine neue Übertragung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transferencia se canceló; inicia una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce transfert a été interrompu ; lancez un nouveau transfert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この転送は中止されました。転送をやり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次传输已中止；请重新开始传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此次傳輸已中止；請重新開始傳輸。"
          }
        }
      }
    },
    "Tilde": {
