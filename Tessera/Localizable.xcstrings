          }
        }
      }
    },
    "iOS could not complete a non-interactive integrity check. Tessera is failing closed for session restore and remote installation until the key becomes available.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS konnte eine nicht-interaktive Integritätsprüfung nicht abschließen. Tessera verweigert Sitzungswiederherstellung und entfernte Installation, bis der Key wieder verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no pudo completar una comprobación de integridad no interactiva. Tessera bloquea la restauración de sesiones y la instalación remota hasta que la clave vuelva a estar disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n'a pas pu terminer une vérification d'intégrité non interactive. Tessera refuse la restauration de session et l'installation à distance tant que la clé n'est pas disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が非対話的な整合性チェックを完了できませんでした。キーが利用可能になるまで、Tessera はセッションの復元とリモート設置を安全側で拒否します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法完成非交互式完整性检查。在密钥恢复可用之前，Tessera 会安全地拒绝会话恢复和远程安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法完成非互動式完整性檢查。在金鑰恢復可用之前，Tessera 會安全地拒絕工作階段回復和遠端安裝。"
          }
        }
      }
    },
    "iOS notification when an off-screen agent finishes or needs input while Tessera is running in the background · iPadOS may suspend longer sessions": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-Mitteilung, wenn ein nicht sichtbarer Agent fertig wird oder eine Eingabe braucht, während Tessera im Hintergrund läuft · iPadOS kann längere Sitzungen anhalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "aviso de iOS cuando un agente fuera de pantalla termina o necesita entrada mientras Tessera está en segundo plano · iPadOS puede suspender las sesiones largas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "notification iOS lorsqu'un agent hors écran termine ou attend une saisie pendant que Tessera est en arrière-plan · iPadOS peut suspendre les sessions longues"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera がバックグラウンドで動作しているときに、画面外のエージェントが完了したり入力を必要としたりすると iOS 通知を送ります · iPadOS は長時間のセッションを一時停止することがあります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Tessera 在后台运行时，屏幕外的智能体完成或需要输入会发出 iOS 通知 · iPadOS 可能会挂起较长的会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Tessera 在背景執行時，畫面外的智慧體完成或需要輸入會發出 iOS 通知 · iPadOS 可能會暫停較長的工作階段"
          }
        }
      }
    },
