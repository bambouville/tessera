    "leaves every Claude/Codex alias and user-defined function unchanged, including added flags, command/env forms, renamed shortcuts, and version-manager PATH changes": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "lässt jeden Claude-/Codex-Alias und jede selbst definierte Funktion unverändert, einschließlich hinzugefügter Flags, command-/env-Formen, umbenannter Kürzel und PATH-Änderungen von Versionsmanagern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "deja intactos todos los alias de Claude/Codex y las funciones definidas por el usuario, incluidos los flags añadidos, las formas command/env, los atajos renombrados y los cambios de PATH de los gestores de versiones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "laisse inchangés tous les alias Claude/Codex et les fonctions définies par l'utilisateur, y compris les options ajoutées, les formes command/env, les raccourcis renommés et les modifications de PATH des gestionnaires de versions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude/Codex のエイリアスとユーザー定義関数はすべてそのままにします。追加されたフラグ、command/env 形式、名前を変えたショートカット、バージョン管理ツールによる PATH の変更も変更しません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持所有 Claude/Codex 别名和用户自定义函数不变，包括附加的参数、command/env 形式、重命名的快捷方式以及版本管理器对 PATH 的修改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持所有 Claude/Codex 別名和使用者自訂函式不變，包括附加的參數、command/env 形式、重新命名的捷徑以及版本管理器對 PATH 的修改"
          }
        }
      }
    },
