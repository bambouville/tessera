          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ruta de salto guardada difiere de la del otro dispositivo. Tessera no la redirigió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
