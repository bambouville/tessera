      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert die lokalen Hook-Dateien und PATH-Shims von Tessera und lädt sie hier, damit künftige Agenten korrekten Status melden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala los archivos de hook locales y los shims de PATH de Tessera, y los carga aquí para que los agentes futuros informen del estado con precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
