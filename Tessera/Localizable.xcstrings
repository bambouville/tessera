          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ リモートホストの識別情報が変わりました。中間者攻撃か、サーバーキーが更新された可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
