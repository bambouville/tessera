    "Sent as a secret-free descriptor. No password, private key, or trust pin was included; authentication happens on this device.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Deskriptor ohne Geheimnisse gesendet. Weder Passwort noch privater Key oder Trust-Pin waren enthalten; die Authentifizierung findet auf diesem Gerät statt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía como un descriptor sin secretos. No se incluyó ninguna contraseña, clave privada ni fijación de confianza; la autenticación ocurre en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé sous forme de descripteur sans secret. Aucun mot de passe, clé privée ou épinglage de confiance n'était inclus ; l'authentification a lieu sur cet appareil."
          }
