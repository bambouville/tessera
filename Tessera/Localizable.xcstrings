    "Loads Tessera's shell marker here. Enable automatically also saves the guarded activation line in this shell's startup file for future windows.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt hier den Shell-Marker von Tessera. „Automatisch aktivieren“ speichert zusätzlich die abgesicherte Aktivierungszeile in der Startdatei dieser Shell für künftige Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga aquí el marcador de shell de Tessera. Activar automáticamente también guarda la línea de activación protegida en el archivo de inicio de este shell para futuras ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge ici le marqueur shell de Tessera. « Activer automatiquement » enregistre aussi la ligne d'activation protégée dans le fichier de démarrage de ce shell, pour les futures fenêtres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで Tessera のシェルマーカーを読み込みます。「自動的に有効化」を選ぶと、今後のウインドウのために、ガード付きの有効化行がこのシェルの起動ファイルにも保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此加载 Tessera 的 shell 标记。选择“自动启用”还会把带保护的激活行写入该 shell 的启动文件，供以后的窗口使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此載入 Tessera 的 shell 標記。選擇「自動啟用」還會把附保護的啟用行寫入該 shell 的啟動檔案，供之後的視窗使用。"
          }
        }
      }
    },
