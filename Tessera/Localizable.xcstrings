        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero devolvió un resultado inesperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau a renvoyé un résultat inattendu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンから予期しない結果が返されました。"
