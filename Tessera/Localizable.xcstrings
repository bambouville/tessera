          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Keyboard があれば、グローバル操作も文脈に応じた操作もキーの組み合わせひとつで実行できます:"
          }
        },
        "zh-Hans": {
