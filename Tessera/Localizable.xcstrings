    "Differs from the key %@ trusts. Verify out of band before connecting.": {
      "comment": "Host-key mismatch against a peer device; the argument names that device",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weicht von dem Key ab, dem %@ vertraut. Prüfe ihn über einen anderen Kanal, bevor du verbindest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Difiere de la clave en la que confía %@. Verifícala por otro canal antes de conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffère de la clé à laquelle %@ fait confiance. Vérifiez-la par un autre canal avant de vous connecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が信頼しているキーと異なります。接続する前に別の経路で確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 %@ 信任的密钥不同。连接前请通过其他渠道核实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 %@ 信任的金鑰不同。連線前請透過其他管道核實。"
          }
        }
      }
    },
