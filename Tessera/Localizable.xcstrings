    },
    "The actual Keychain boundary currently uses device-unlocked protection.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die tatsächliche Schlüsselbund-Grenze nutzt derzeit den Schutz „Gerät entsperrt“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite real del llavero usa actualmente la protección de dispositivo desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite réelle du trousseau utilise actuellement la protection « appareil déverrouillé »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の実際のキーチェーン境界では、デバイスのロック解除による保護が使われています。"
