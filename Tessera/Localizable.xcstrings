    "Approve sends only this public key to the host. No password or private key crosses devices.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bestätigen“ sendet nur diesen Public Key an den Host. Weder Passwort noch privater Key wechseln zwischen den Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar envía únicamente esta clave pública al host. Ninguna contraseña ni clave privada pasa de un dispositivo a otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver n'envoie que cette clé publique à l'hôte. Aucun mot de passe ni clé privée ne circule entre les appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「承認」すると、この公開鍵だけがホストに送られます。パスワードや秘密鍵がデバイス間を移動することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「批准」只会把这个公钥发送到主机。密码和私钥都不会在设备之间传递。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「核准」只會把這個公開金鑰傳送到主機。密碼和私密金鑰都不會在裝置之間傳遞。"
          }
        }
      }
    },
