    "Secure Enclave private material cannot leave this device. Keep a second, recoverable credential authorized on every host that uses it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privates Material im Secure Enclave kann dieses Gerät nicht verlassen. Halte auf jedem Host, der ihn nutzt, einen zweiten, wiederherstellbaren Zugang autorisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material privado del Secure Enclave no puede salir de este dispositivo. Mantén autorizada una segunda credencial recuperable en cada host que la use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matériel privé du Secure Enclave ne peut pas quitter cet appareil. Gardez un second identifiant récupérable autorisé sur chaque hôte qui l'utilise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave 内の秘密情報はこのデバイスの外に出せません。これを使うすべてのホストで、復旧可能な 2 つ目の資格情報を有効にしておいてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave 中的私密材料无法离开本设备。请在每台使用它的主机上保留第二个可恢复的授权凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave 中的私密材料無法離開本裝置。請在每台使用它的主機上保留第二個可回復的授權憑證。"
          }
        }
      }
    },
    "Secure Enclave protection cannot be changed after creation. Rotate the key instead.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Secure-Enclave-Schutz lässt sich nach dem Erstellen nicht mehr ändern. Wechsle stattdessen den Key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección del Secure Enclave no se puede cambiar después de crearla. Rota la clave en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection Secure Enclave ne peut pas être modifiée après la création. Remplacez plutôt la clé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave の保護設定は、作成後に変更できません。代わりにキーを更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave 保护在创建后无法更改。请改为轮换密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave 保護在製作後無法更改。請改為輪換金鑰。"
          }
        }
      }
    },
