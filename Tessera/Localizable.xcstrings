          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se registró una exportación de recuperación el %@. Confirma que aún tienes su frase de contraseña antes de eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un export de récupération a été enregistré le %@. Confirmez que vous disposez encore de sa phrase secrète avant de supprimer."
