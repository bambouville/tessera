    "prepends optional PATH shims for fast empty-composer detection while resolving the real executable from the live PATH on every launch": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "stellt optionale PATH-Shims voran, um ein leeres Eingabefeld schnell zu erkennen, und ermittelt bei jedem Start die echte ausführbare Datei aus dem aktuellen PATH"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "antepone shims de PATH opcionales para detectar rápidamente un redactor vacío, resolviendo el ejecutable real desde el PATH vigente en cada arranque"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ajoute en tête des shims de PATH facultatifs pour détecter rapidement un champ de saisie vide, tout en résolvant le véritable exécutable depuis le PATH en vigueur à chaque lancement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄が空かどうかを素早く判定するために、任意の PATH シムを先頭に追加します。実際の実行ファイルは起動のたびに現在の PATH から解決されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 PATH 前置可选垫片以快速检测空输入框，同时每次启动都从当前 PATH 解析真实可执行文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 PATH 前置選用墊片以快速偵測空輸入框，同時每次啟動都從目前 PATH 解析真實執行檔"
          }
        }
      }
    },
