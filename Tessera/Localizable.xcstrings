    "Timed out completing the SSH handshake. The connection opened but never finished negotiating — often a path-MTU blackhole on the route.": {
      "comment": "SSH connect gave up waiting for the handshake to finish",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim SSH-Handshake. Die Verbindung kam zustande, wurde aber nie fertig ausgehandelt — oft ein Path-MTU-Blackhole auf der Strecke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo al completar el handshake SSH. La conexión se abrió pero nunca terminó de negociarse: suele ser un agujero negro de MTU de ruta en el trayecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai dépassé lors du handshake SSH. La connexion s'est ouverte mais n'a jamais fini de négocier — souvent un trou noir de MTU de chemin sur la route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ハンドシェイクの完了がタイムアウトしました。接続は確立しましたが、ネゴシエーションが完了しませんでした — 経路上のパス MTU ブラックホールであることが多いです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成 SSH 握手超时。连接已建立但始终未完成协商 — 通常是路径上的 path-MTU 黑洞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成 SSH 交握逾時。連線已建立但始終未完成協商 — 通常是路徑上的 path-MTU 黑洞。"
          }
        }
      }
    },
    "Toggle Agent Center": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Center ein-/ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar u ocultar el centro de agentes"
          }
        },
        "fr": {
