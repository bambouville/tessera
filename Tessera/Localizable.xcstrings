    "emits only provider, lifecycle event, state, reason, timestamp, and local process ID — never prompts, responses, source code, credentials, or API traffic": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gibt nur Anbieter, Lifecycle-Ereignis, Zustand, Grund, Zeitstempel und lokale Prozess-ID aus — niemals Prompts, Antworten, Quellcode, Anmeldedaten oder API-Traffic"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "emite solo el proveedor, el evento de ciclo de vida, el estado, el motivo, la marca de tiempo y el ID de proceso local: nunca prompts, respuestas, código fuente, credenciales ni tráfico de API"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "n'émet que le fournisseur, l'événement de cycle de vie, l'état, la raison, l'horodatage et l'identifiant de processus local — jamais les prompts, les réponses, le code source, les identifiants ni le trafic d'API"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信するのはプロバイダ、ライフサイクルイベント、状態、理由、タイムスタンプ、ローカルのプロセス ID だけです。プロンプト、応答、ソースコード、認証情報、API 通信を送ることはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只发送提供方、生命周期事件、状态、原因、时间戳和本地进程 ID —— 绝不发送提示词、响应、源代码、凭据或 API 流量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只傳送提供者、生命週期事件、狀態、原因、時間戳記和本機處理程序 ID —— 絕不傳送提示詞、回應、原始碼、憑證或 API 流量"
          }
        }
      }
    },
