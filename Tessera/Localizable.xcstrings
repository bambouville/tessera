    "applies to every session unless a host overrides it. full-screen apps that set their own colors (vim, htop) paint over the picture.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gilt für jede Sitzung, sofern ein Host es nicht überschreibt. Vollbild-Programme mit eigenen Farben (vim, htop) übermalen das Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se aplica a todas las sesiones salvo que un host lo anule. las apps a pantalla completa que fijan sus propios colores (vim, htop) pintan por encima de la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "s'applique à toutes les sessions, sauf si un hôte le remplace. les apps en plein écran qui définissent leurs propres couleurs (vim, htop) recouvrent l'image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
