      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schnelles Terminal für SSH & Mosh — natives tmux, entfernte Dateien, agentenbewusste Steuerung und eine Tastatur für dein Telefon. Lust auf eine kurze Tour?"
