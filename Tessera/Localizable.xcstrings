    "Uses secondary SSH to verify this terminal's integration. Your key may ask to unlock.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft die Integration dieses Terminals über eine zweite SSH-Verbindung. Dein Key fragt dabei möglicherweise nach dem Entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una segunda conexión SSH para verificar la integración de este terminal. Puede que tu clave pida desbloquearse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une seconde connexion SSH pour vérifier l'intégration de ce terminal. Votre clé peut demander à être déverrouillée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二次的な SSH 接続を使って、このターミナルの統合状態を確認します。キーのロック解除を求められることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用第二条 SSH 连接校验此终端的集成状态。你的密钥可能会要求解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用第二條 SSH 連線檢驗此終端機的整合狀態。你的金鑰可能會要求解鎖。"
          }
        }
      }
    },
