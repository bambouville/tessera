    "your free host is already saved. unlock unlimited saved hosts with one purchase — every tessera feature stays included either way.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein kostenloser Host ist bereits gesichert. Schalte mit einem Kauf unbegrenzt viele gesicherte Hosts frei — alle Tessera-Funktionen bleiben so oder so enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tu host gratuito ya está guardado. desbloquea hosts guardados ilimitados con una sola compra — todas las funciones de Tessera siguen incluidas en cualquier caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "votre hôte gratuit est déjà enregistré. débloquez un nombre illimité d'hôtes enregistrés avec un seul achat — toutes les fonctionnalités de Tessera restent incluses dans les deux cas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料枠のホストはすでに保存済みです。1 回の購入で、保存できるホスト数を無制限にできます — どちらの場合も Tessera の全機能が使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费主机已保存。一次购买即可解锁无限的已保存主机 —— 无论如何，Tessera 的所有功能都始终包含在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免費主機已儲存。一次購買即可解鎖無限的已儲存主機 —— 無論如何，Tessera 的所有功能都始終包含在內。"
          }
        }
      }
    },
