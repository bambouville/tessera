    "letters, numbers, dash, underscore, dot only; anything else falls back to the auto-derived name.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nur Buchstaben, Ziffern, Bindestrich, Unterstrich und Punkt; alles andere fällt auf den automatisch abgeleiteten Namen zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "solo letras, números, guion, guion bajo y punto; cualquier otra cosa vuelve al nombre derivado automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "lettres, chiffres, tiret, tiret bas et point uniquement ; tout le reste revient au nom déduit automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使えるのは英数字・ハイフン・アンダースコア・ピリオドだけです。それ以外の場合は自動生成された名前が使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能使用字母、数字、连字符、下划线和点；其他情况一律回退到自动生成的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能使用字母、數字、連字符、底線和點；其他情況一律回退到自動產生的名稱。"
          }
        }
      }
    },
