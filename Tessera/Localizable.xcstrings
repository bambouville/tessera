    "Installs Tessera's hook files now. Relaunch this running agent afterward so it can report lifecycle status.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert jetzt die Hook-Dateien von Tessera. Starte den laufenden Agenten danach neu, damit er den Lifecycle-Status melden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala ahora los archivos de hook de Tessera. Reinicia después el agente en ejecución para que pueda informar del estado del ciclo de vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe maintenant les fichiers de hook de Tessera. Relancez ensuite l'agent en cours pour qu'il puisse remonter son état de cycle de vie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera のフックファイルを今すぐインストールします。その後、実行中のエージェントを再起動すると、ライフサイクル状態を報告できるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即安装 Tessera 的钩子文件。之后请重新启动正在运行的智能体，使其能够上报生命周期状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即安裝 Tessera 的掛鉤檔案。之後請重新啟動執行中的智慧體，使其能夠回報生命週期狀態。"
          }
        }
      }
    },
    "Installs Tessera's local hook files and PATH shims, then loads them here so future agents report accurate status.": {
