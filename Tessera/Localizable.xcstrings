    "WSL2 reports an outer MTU of %lld while tailscale0 uses %lld. Larger SSH replies may stall.": {
      "comment": "Path-MTU warning; the arguments are byte counts for two network interfaces",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WSL2 meldet eine äußere MTU von %1$lld, während tailscale0 %2$lld verwendet. Größere SSH-Antworten können hängen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WSL2 informa de una MTU externa de %1$lld mientras que tailscale0 usa %2$lld. Las respuestas SSH grandes pueden quedarse bloqueadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WSL2 signale une MTU externe de %1$lld alors que tailscale0 utilise %2$lld. Les réponses SSH volumineuses peuvent se bloquer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WSL2 は外側の MTU を %1$lld と報告していますが、tailscale0 は %2$lld を使用しています。大きな SSH 応答が停止する可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WSL2 报告的外层 MTU 为 %1$lld，而 tailscale0 使用 %2$lld。较大的 SSH 响应可能会卡住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WSL2 回報的外層 MTU 為 %1$lld，而 tailscale0 使用 %2$lld。較大的 SSH 回應可能會卡住。"
          }
        }
      }
    },
