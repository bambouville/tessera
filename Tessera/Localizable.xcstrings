{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" already uses this chord.": {
      "comment": "Chord conflict; the argument is another custom shortcut's name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ belegt diese Tastenkombination bereits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya usa esta combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » utilise déjà cette combinaison."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」がこのキーの組み合わせをすでに使用しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已使用该组合键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已使用這個組合鍵。"
          }
        }
      }
    },
    "%@ and no tessera account": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und kein Tessera-Konto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y sin cuenta de tessera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et aucun compte tessera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、tessera アカウントも不要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，也无需 tessera 账户"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，也無需 tessera 帳戶"
          }
        }
      }
    },
    "%@ is running a newer version of Tessera%@. Update Tessera on this device, then try again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verwendet eine neuere Tessera-Version%2$@. Aktualisiere Tessera auf diesem Gerät und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ejecuta una versión más reciente de Tessera%2$@. Actualiza Tessera en este dispositivo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ utilise une version plus récente de Tessera%2$@. Mettez Tessera à jour sur cet appareil, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はより新しいバージョンの Tessera%2$@ を使用しています。このデバイスの Tessera を更新してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 运行的是更新版本的 Tessera%2$@。请先更新本设备上的 Tessera，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 執行的是更新版本的 Tessera%2$@。請先更新本裝置上的 Tessera，然後重試。"
          }
        }
      }
    },
    "%@ is running an older version of Tessera%@. Update Tessera on %@, then try again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verwendet eine ältere Tessera-Version%2$@. Aktualisiere Tessera auf %3$@ und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ejecuta una versión anterior de Tessera%2$@. Actualiza Tessera en %3$@ y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ utilise une version plus ancienne de Tessera%2$@. Mettez Tessera à jour sur %3$@, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は古いバージョンの Tessera%2$@ を使用しています。%3$@ の Tessera を更新してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 运行的是较旧版本的 Tessera%2$@。请先更新 %3$@ 上的 Tessera，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 執行的是較舊版本的 Tessera%2$@。請先更新 %3$@ 上的 Tessera，然後重試。"
          }
        }
      }
    },
    "%@ is working — scrolling is temporarily disabled": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arbeitet – Scrollen ist vorübergehend deaktiviert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está trabajando: el desplazamiento está desactivado temporalmente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ travaille — le défilement est temporairement désactivé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の処理中です。スクロールは一時的に無効になっています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行 —— 滚动暂时停用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行 —— 捲動暫時停用"
          }
        }
      }
    },
    "%@ is working. Scrolling is temporarily disabled.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arbeitet. Scrollen ist vorübergehend deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está trabajando. El desplazamiento está desactivado temporalmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ travaille. Le défilement est temporairement désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の処理中です。スクロールは一時的に無効になっています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行。滚动暂时停用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行。捲動暫時停用。"
          }
        }
      }
    },
    "%@ left — control returned here": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Sitzung verlassen — die Steuerung ist wieder hier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salió; el control ha vuelto aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a quitté la session — le contrôle est revenu ici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が離脱しました — 操作権はこのデバイスに戻りました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已离开 —— 控制权已回到此设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已離開 —— 控制權已回到此裝置"
          }
        }
      }
    },
    "%@ sent setup data from a newer version of Tessera. Update Tessera on this device, then try again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Einrichtungsdaten aus einer neueren Tessera-Version gesendet. Aktualisiere Tessera auf diesem Gerät und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envió datos de configuración de una versión más reciente de Tessera. Actualiza Tessera en este dispositivo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a envoyé des données de configuration issues d'une version plus récente de Tessera. Mettez Tessera à jour sur cet appareil, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はより新しいバージョンの Tessera のセットアップデータを送信しました。このデバイスの Tessera を更新してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 发送的设置数据来自更新版本的 Tessera。请先更新本设备上的 Tessera，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 傳送的設定資料來自更新版本的 Tessera。請先更新本裝置上的 Tessera，然後重試。"
          }
        }
      }
    },
    "%@ sent setup data from an older version of Tessera. Update Tessera on %@, then try again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat Einrichtungsdaten aus einer älteren Tessera-Version gesendet. Aktualisiere Tessera auf %2$@ und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ envió datos de configuración de una versión anterior de Tessera. Actualiza Tessera en %2$@ y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a envoyé des données de configuration issues d'une version plus ancienne de Tessera. Mettez Tessera à jour sur %2$@, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は古いバージョンの Tessera のセットアップデータを送信しました。%2$@ の Tessera を更新してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 发送的设置数据来自较旧版本的 Tessera。请先更新 %2$@ 上的 Tessera，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 傳送的設定資料來自較舊版本的 Tessera。請先更新 %2$@ 上的 Tessera，然後重試。"
          }
        }
      }
    },
    "%@ sent setup data with a field this version of Tessera does not accept (%@.%@). If %@ is running a newer version of Tessera, update this device, then try again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat Einrichtungsdaten mit einem Feld gesendet, das diese Tessera-Version nicht akzeptiert (%2$@.%3$@). Falls %4$@ eine neuere Tessera-Version verwendet, aktualisiere dieses Gerät und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ envió datos de configuración con un campo que esta versión de Tessera no acepta (%2$@.%3$@). Si %4$@ ejecuta una versión más reciente de Tessera, actualiza este dispositivo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a envoyé des données de configuration comportant un champ que cette version de Tessera n'accepte pas (%2$@.%3$@). Si %4$@ utilise une version plus récente de Tessera, mettez cet appareil à jour, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は、このバージョンの Tessera が受け付けないフィールド (%2$@.%3$@) を含むセットアップデータを送信しました。%4$@ がより新しいバージョンの Tessera を使用している場合は、このデバイスを更新してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 发送的设置数据包含此版本 Tessera 不接受的字段 (%2$@.%3$@)。如果 %4$@ 运行的是更新版本的 Tessera，请更新本设备后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 傳送的設定資料包含此版本 Tessera 不接受的欄位 (%2$@.%3$@)。如果 %4$@ 執行的是更新版本的 Tessera，請更新本裝置後重試。"
          }
        }
      }
    },
