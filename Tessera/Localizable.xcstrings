    "Code %@ matched. %@ must approve before any setup data can be sent.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code %@ stimmt überein. %@ muss bestätigen, bevor Einrichtungsdaten gesendet werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código %@ coincide. %@ debe aprobar antes de que se envíe ningún dato de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code %@ correspond. %@ doit approuver avant l'envoi de toute donnée de configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コード %1$@ が一致しました。セットアップのデータを送信するには、%2$@ での承認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码 %1$@ 已匹配。必须先经 %2$@ 批准，才能发送任何设置数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼 %1$@ 已相符。必須先經 %2$@ 核准，才能傳送任何設定資料。"
          }
        }
      }
    },
    "Code %@ matched. Optional host text and trust start off. Review this exact setup transfer and where to install %@.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code %@ stimmt überein. Optionaler Host-Text und Vertrauen sind zunächst aus. Prüfe genau diese Übertragung und wo %@ installiert werden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código %@ coincide. El texto opcional de los hosts y la confianza empiezan desactivados. Revisa exactamente esta transferencia y dónde instalar %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code %@ correspond. Le texte d'hôte facultatif et la confiance sont désactivés au départ. Vérifiez précisément ce transfert et l'endroit où installer %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コード %1$@ が一致しました。任意のホストテキストと信頼設定は初期状態でオフです。この転送内容と、%2$@ をどこに設置するかを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码 %1$@ 已匹配。可选的主机文本和信任默认关闭。请核对这次转移的具体内容，以及要把 %2$@ 安装到哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼 %1$@ 已相符。選用的主機文字和信任預設關閉。請核對這次轉移的具體內容，以及要把 %2$@ 安裝到哪裡。"
          }
        }
      }
    },
