    "With a Magic Keyboard, global and context-aware actions stay a chord away:": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Magic Keyboard bleiben globale und kontextabhängige Aktionen nur einen Tastengriff entfernt:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un Magic Keyboard, las acciones globales y contextuales están a un acorde de distancia:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
