          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有一台已儲存的主機在使用該接續識別碼，但其端點並不相符。請先檢查該主機再重新連線。"
          }
        }
      }
    },
    "A saved jump host has different connection details. Tessera did not change it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gesicherter Jump-Host hat andere Verbindungsdaten. Tessera hat ihn nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
