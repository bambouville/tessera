          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte una imagen hacia Tessera y elige una sesión activa. Tessera la sube, escribe la ruta y Claude Code o Codex la adjunta automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez une image vers Tessera et choisissez une session active. Tessera l'envoie, saisit le chemin, et Claude Code ou Codex l'attache automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
