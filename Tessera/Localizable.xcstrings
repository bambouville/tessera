    "The host key for this server has changed since the last connection. This could indicate a man-in-the-middle attack, or the server was reinstalled.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host-Key dieses Servers hat sich seit der letzten Verbindung geändert. Das kann auf einen Man-in-the-Middle-Angriff hindeuten oder darauf, dass der Server neu aufgesetzt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de host de este servidor ha cambiado desde la última conexión. Podría indicar un ataque de intermediario, o que el servidor se reinstaló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d'hôte de ce serveur a changé depuis la dernière connexion. Cela peut indiquer une attaque de l'intercepteur, ou une réinstallation du serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーのホストキーが前回の接続以降に変更されました。中間者攻撃の可能性、あるいはサーバーが再インストールされた可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器的主机密钥自上次连接以来已改变。这可能意味着中间人攻击，也可能是服务器被重装了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器的主機金鑰自上次連線以來已改變。這可能意味著中間人攻擊，也可能是伺服器被重裝了。"
          }
        }
      }
    },
    "The host or authentication policy changed while connecting. Try again.": {
