{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera://protocol-vectors/pairing/v1/offer.schema.json",
  "title": "Tessera Pairing Offer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "offerID", "purpose", "expiresAt", "originRole",
    "originEphemeralKeyOrCommitment", "endpointCandidates",
    "supportedPairingVersions", "supportedTransactionVersions"
  ],
  "properties": {
    "version": { "const": 1 },
    "offerID": { "type": "string", "format": "uuid" },
    "purpose": { "enum": ["continue", "bootstrap", "enroll", "setUpAndContinue"] },
    "expiresAt": { "type": "integer", "minimum": 1 },
    "originRole": { "const": "origin" },
    "originEphemeralKeyOrCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "commitment" },
        "value": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "endpointCandidates": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transport", "host", "port"],
        "properties": {
          "transport": { "const": "tcp" },
          "host": { "type": "string", "minLength": 1, "maxLength": 253 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "oneTimeOpticalSecret": { "type": "string", "contentEncoding": "base64" },
    "supportedPairingVersions": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true
    },
    "supportedTransactionVersions": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true
    },
    "optionalPayloadDigest": { "type": "string", "contentEncoding": "base64" }
  }
}
