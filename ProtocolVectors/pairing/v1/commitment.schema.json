{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera://protocol-vectors/pairing/v1/commitment.schema.json",
  "title": "Tessera Pairing Commitment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "offerID", "purpose", "role", "offerDigest",
    "supportedPairingVersions", "supportedTransactionVersions",
    "selectedPairingVersion", "selectedTransactionVersion", "helloDigest"
  ],
  "properties": {
    "version": { "const": 1 },
    "offerID": { "type": "string", "format": "uuid" },
    "purpose": { "enum": ["continue", "bootstrap", "enroll", "setUpAndContinue"] },
    "role": { "const": "recipient" },
    "offerDigest": { "$ref": "#/$defs/digest" },
    "supportedPairingVersions": { "$ref": "#/$defs/versionList" },
    "supportedTransactionVersions": { "$ref": "#/$defs/versionList" },
    "selectedPairingVersion": { "type": "integer", "minimum": 1 },
    "selectedTransactionVersion": { "type": "integer", "minimum": 1 },
    "helloDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 44,
      "maxLength": 44
    },
    "versionList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    }
  }
}
