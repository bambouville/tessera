      "current": [
        "S2",
        "S3"
      ],
      "cohort": [],
      "stored": [
        "S1",
        "S2"
      ],
      "preferredSelection": null,
      "storedSelection": "S1",
      "maxSnapshots": 64,
      "expected": {
        "entries": [
          {
            "session": "S1",
            "source": "stored"
          },
          {
            "session": "S2",
            "source": "current"
          },
          {
            "session": "S3",
            "source": "current"
          }
        ],
        "selectedSession": "S1"
      }
    },
    {
      "name": "the background edge carries a session that is no longer live",
