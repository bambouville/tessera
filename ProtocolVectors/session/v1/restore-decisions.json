        "S2"
      ],
      "stored": [],
      "preferredSelection": "S1",
      "storedSelection": null,
      "maxSnapshots": 64,
      "expected": {
        "entries": [
          {
            "session": "S1",
            "source": "current"
          },
          {
            "session": "S2",
            "source": "cohort"
          }
        ],
        "selectedSession": "S1"
      }
    },
    {
      "name": "a merge keeps stored order and lets the live copy win",
