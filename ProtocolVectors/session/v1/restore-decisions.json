            "session": "S1",
            "source": "stored"
          }
        ],
        "selectedSession": "S1"
      }
    },
    {
      "name": "what is on screen outranks the stored selection",
      "mode": "mergeWithStored",
      "current": [
        "S2"
      ],
      "cohort": [],
      "stored": [
        "S1",
        "S2"
      ],
      "preferredSelection": "S2",
      "storedSelection": "S1",
      "maxSnapshots": 64,
      "expected": {
        "entries": [
          {
            "session": "S1",
            "source": "stored"
          },
          {
            "session": "S2",
            "source": "current"
          }
        ],
        "selectedSession": "S2"
      }
    },
