scenario w4-lost-latest-handoff
# W4: from 3.3a, when `latest` disconnects it passes to the remaining client
# with the newest activity among those showing the window.
versions 3.3a 3.4 3.6a
session O 80x24 w0
group O-tessera-view O
session probes 80x24 p0
control probe probes no-output
control side O-tessera-view no-output
send side refresh-client -C 90,28
tty laptop O 200x50
key laptop
control device O
send device select-window ; refresh-client -C 100,30
expect-latest w0 device
expect-size w0 100x30
detach device
expect-latest w0 laptop
expect-size w0 200x49
send probe display-message -p -t {w0} 'size=#{window_width}x#{window_height}'
expect probe size=200x49
