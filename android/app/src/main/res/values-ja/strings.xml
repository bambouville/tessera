    <string name="app_illus_windows_panes_detail">スマートフォンでは 1 つのペインに集中</string>
    <string name="app_illus_agent_center_detail">すべてのセッションをまたいで</string>
    <string name="app_illus_working">実行中</string>
    <string name="app_illus_needs_input">入力待ち</string>
