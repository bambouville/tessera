    <string name="app_onboarding_back">back</string>
    <string name="app_onboarding_next">next</string>
    <string name="app_onboarding_pane_title">walkthrough</string>
    <string name="app_whats_new_body">The bottom bar has new places. Here is what moved, and where it went.</string>
    <string name="app_whats_new_before">before</string>
    <string name="app_whats_new_now">now</string>
    <string name="app_whats_new_artifacts_body">Takes keys’ place in the bar. Docs, pages, agent changes and files from every session are tabs that stay with their host.</string>
    <string name="app_whats_new_keys_title">keys and known hosts</string>
    <string name="app_whats_new_keys_body">In Settings now, beside security.</string>
    <string name="app_open_in_artifacts">Open in Artifacts</string>
    <string name="app_whats_new_open_body">Where Quick open was — in a file’s ⋮ menu and the terminal selection toolbar.</string>
    <string name="app_whats_new_again">again any time in Settings → About</string>
    <string name="app_onboarding_add_host_title">add your first host</string>
    <string name="app_onboarding_add_host_body">Start here. Name it, enter an address, choose an SSH key, then connect.</string>
    <string name="app_onboarding_keys_title">keys, protected your way</string>
    <string name="app_onboarding_keys_body">Keys and known hosts live in Settings, beside security. Generate a device-bound P-256 key or import an SSH key. Owner authentication is optional, and Tessera can install the public key for you.</string>
    <string name="app_onboarding_tmux_title">tmux windows &amp; panes</string>
    <string name="app_onboarding_tmux_body">Open and switch tmux windows from the top bar. Split panes stay intact while the focused pane fits the phone viewport.</string>
    <string name="app_onboarding_agents_body">Follow Claude Code and Codex across every session. See who needs input, answer a prompt, or jump straight to the right terminal. The agents tab shows while Agent Center is on.</string>
    <string name="app_onboarding_prompts_title">prompt controls</string>
    <string name="app_onboarding_prompts_body">With Agent Center on in Settings, answer live prompts by tapping an option or typing a reply. The terminal keyboard bar keeps shell controls within reach too.</string>
    <string name="app_onboarding_files_title">files from your phone</string>
    <string name="app_onboarding_files_body">Open Files from the terminal top bar to browse, download, and open files in Artifacts. SSH, tmux, and mosh sessions share the same file tools.</string>
    <string name="app_onboarding_artifacts_body">Every tab from every session, grouped by host. A file you open lands here, and sessions keeps your terminal where you left it.</string>
    <string name="app_onboarding_open_title">open in artifacts</string>
    <string name="app_onboarding_open_body">Choose Open in Artifacts in a file’s ⋮ menu or on a path you select in the terminal. A localhost link opens here too, over a forward made for its tab.</string>
    <string name="app_onboarding_share_title">share, in and out</string>
    <string name="app_onboarding_share_body">Send a remote file to another app with Share…, or share a local file into Tessera and choose its host and upload destination. Android’s share sheet works in both directions.</string>
    <string name="app_onboarding_screenshot_title">paste a screenshot</string>
    <string name="app_onboarding_screenshot_body">Share an image into Tessera, choose a host, and enable Paste path into session. Tessera uploads it and types the remote path for Claude Code or Codex when the session connects.</string>
    <string name="app_onboarding_controls_title">terminal controls</string>
    <string name="app_onboarding_controls_body">The keyboard bar keeps Escape, arrows, Tab, Control, and other shell keys within reach. Tap a modifier for the next key, or choose sticky modifiers in Settings.</string>
