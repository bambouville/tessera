    <string name="app_onboarding_welcome_title">welcome to Tessera</string>
    <string name="app_onboarding_welcome_body">A fast terminal for SSH &amp; Mosh — native tmux, remote files, agent-aware controls, and a keyboard built for your phone. Want a quick tour?</string>
